# Local .terraform directories
**/.terraform/*
.DS_Store

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files, which are likely to contain sensitive data, such as
# password, private keys, and other secrets. These should not be part of version
# control as they are data points which are potentially sensitive and subject
# to change depending on the environment.
*.tfvars
*.tfvars.json
# terraform.tfvars has no secrets and is in git, secrets go in the OCI vault
!terraform.tfvars

# Ignore override files as they are usually used to override resources locally and so
# are not checked in
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Include override files you do wish to add to version control using negated pattern
# !example_override.tf

# Saved plans from terraform plan -out can hold secret values
*.tfplan

# Ignore CLI configuration files
.terraformrc
terraform.rc

.kube.config
# no credentials inside, the oci CLI makes the token. terraform/accounts/a writes it
!terraform/.kube.config

# Claude Code
.claude/
.claude.json

# Swap
[._]*.s[a-v][a-z]
# the pattern above also matches .svg files, keep them
!*.svg
[._]*.sw[a-p]
[._]s[a-rt-v][a-z]
[._]ss[a-gi-z]
[._]sw[a-p]

# Session
Session.vim
Sessionx.vim

# Temporary
.netrwhist
*~
# Auto-generated tag files
tags
# Persistent undo
[._]*.un~
