# Copy to terraform.tfvars and set your own values.
compartment_id               = "ocid1.tenancy.oc1..example"
tenancy_id                   = "ocid1.tenancy.oc1..example"
ssh_public_key               = "ssh-ed25519 AAAA... you@example.com"
kubernetes_worker_nodes      = 2
region                       = "us-phoenix-1"
node_memory_in_gbs           = 12
node_ocpus                   = 2
node_boot_volume_size_in_gbs = 75

# account B
account_b_tenancy_id = "ocid1.tenancy.oc1..accountb"
# output rpc_id of account-b. Leave it out until account B exists.
# account_b_rpc_id = "ocid1.remotepeeringconnection.oc1.us-chicago-1.example"
